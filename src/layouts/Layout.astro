---
interface Props {
  title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const description =
  "Portfolio of Rustice Vincent Caldeo, an Information Technology student interested in software development, databases, and practical technology projects.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | IT Student Portfolio</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <meta property="og:title" content="Rustice Vincent Caldeo | IT Student Portfolio" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}og.image.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rustice Vincent Caldeo Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href={`${baseUrl}fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Rustice Vincent Caldeo",
      email: "yesreck@gmail.com",
      sameAs: [
        "https://github.com/Mikthz",
        "https://www.linkedin.com/in/rustice-vincent-caldeo-a36b33446/",
      ],
      description,
      knowsAbout: [
        "Python",
        "JavaScript",
        "Web development",
        "Database management",
        "Networking fundamentals",
        "Computer vision",
      ],
    })} />
  </head>
  <body class="bg-[var(--background)] text-[var(--white)] min-h-screen">
    <slot />
    <script>
      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion && "IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -28px 0px" }
        );

        revealItems.forEach((item) => {
          item.classList.add("reveal-ready");
          revealObserver.observe(item);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2") format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --background: #101010;
    --surface: #171717;
    --surface-raised: #1d1b22;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #c2c0c9;
    --white-icon-tr: #ffffff14;
    --line: #ffffff16;
    --muted: #9996a2;
  }

  * {
    font-family: "Montserrat Variable", -apple-system, system-ui, sans-serif;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
    background: var(--background);
  }

  body {
    margin: 0;
    padding: 0 1.25rem;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  ::selection {
    background: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #494052;
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  .page-width {
    width: min(100%, 1080px);
    margin-inline: auto;
  }

  .section-block {
    padding: 5.25rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 92px;
  }

  .section-kicker {
    margin: 0 0 .55rem;
    color: var(--sec);
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0 0 1.6rem;
    color: var(--white);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -.045em;
  }

  .section-copy {
    color: var(--white-icon);
    font-size: 1rem;
    line-height: 1.9;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #19171e, #131313 72%);
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid #ffffff1c;
    border-radius: 999px;
    background: #ffffff08;
    padding: .48rem .78rem;
    color: var(--white-icon);
    font-size: .85rem;
    line-height: 1.25;
  }

  .text-link {
    color: #d3bbff;
    text-decoration: underline;
    text-decoration-color: #a476ff70;
    text-underline-offset: 4px;
    transition: color .2s ease, text-decoration-color .2s ease;
  }

  .text-link:hover {
    color: white;
    text-decoration-color: white;
  }

  [data-reveal] {
    --reveal-delay: 0ms;
  }

  [data-reveal].reveal-ready {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .65s ease var(--reveal-delay), transform .65s cubic-bezier(.2,.7,.2,1) var(--reveal-delay);
  }

  [data-reveal].reveal-ready.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .shiny-sec {
    background: linear-gradient(110deg, #a476ff 15%, #e8dcff 48%, #a476ff 82%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 5s ease-in-out infinite;
  }

  @keyframes shine {
    0%, 100% { background-position: 100% 50%; }
    50% { background-position: 0% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal].reveal-ready,
    [data-reveal].reveal-ready.is-visible {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }

  @media (min-width: 640px) {
    body { padding-inline: 2rem; }
  }

  @media (max-width: 767px) {
    html { scroll-padding-top: 28px; }
    body { padding-bottom: 82px; }
    .section-block { padding: 3.8rem 0; scroll-margin-top: 20px; }
  }
</style>
