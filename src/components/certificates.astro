---
const baseUrl = import.meta.env.BASE_URL;
const certificates = [
  {
    title: "Toxic Truths: Symposium on Drug Education, Prevention, and Control",
    date: "March 29, 2025",
    issuer: "Barkada Kontra Droga – FCU Chapter",
    image: `${baseUrl}certificates/toxic-truths.webp`,
    file: `${baseUrl}certificates/toxic-truths.webp`,
    alt: "Certificate of participation for Toxic Truths symposium",
  },
  {
    title: "Symposium on Fire Safety, Prevention, and Control",
    date: "March 15, 2025",
    issuer: "FCU NSTP-CWTS · Coastal Leaders Environmental Action Network (CLEAN)",
    image: `${baseUrl}certificates/fire-safety.webp`,
    file: `${baseUrl}certificates/fire-safety.webp`,
    alt: "Certificate of participation for the symposium on fire safety, prevention, and control",
  },
  {
    title: "Volunteering for Water: Shaping a National Volunteering Framework in the Water Sector – Visayas Cluster",
    date: "February 19, 2025",
    issuer: "Philippine National Volunteer Service Coordinating Agency and National Water Resources Board",
    image: `${baseUrl}certificates/volunteering-for-water.webp`,
    file: `${baseUrl}certificates/volunteering-for-water.pdf`,
    alt: "Certificate of participation for Volunteering for Water, Visayas Cluster",
  },
  {
    title: "Banahaw: Rising to New Heights in Humanitarian Service",
    date: "November 29 – December 1, 2024",
    issuer: "Filamer Christian University College and Senior Red Cross Youth · Capiz Chapter",
    image: `${baseUrl}certificates/banahaw-humanitarian-service.webp`,
    file: `${baseUrl}certificates/banahaw-humanitarian-service.webp`,
    alt: "Certificate of participation for Banahaw: Rising to New Heights in Humanitarian Service, held at Filamer Christian University",
  },
  {
    title: "Alcoholism: Sa Bawat Tagay, Atay Ay Ba-bye",
    date: "June 2023",
    issuer: "Level 1-A Nursing Students · Filamer Christian University",
    image: `${baseUrl}certificates/alcoholism.webp`,
    file: `${baseUrl}certificates/alcoholism.webp`,
    alt: "Certificate of participation for the health teaching activity about alcoholism",
  },
];
---

<section id="certificates" class="section-block">
  <div class="page-width">
    <div class="certificate-heading">
      <div>
        <p class="section-kicker">07 / Participation & Learning</p>
        <h2 class="section-title">Certificates &amp; Participation</h2>
        <p class="section-copy -mt-3 max-w-2xl">Selected participation certificates from academic and community activities.</p>
      </div>
      <span class="certificate-count"><strong>{certificates.length.toString().padStart(2, "0")}</strong> DOCUMENTED</span>
    </div>

    <div class="certificate-grid">
      {certificates.map((certificate, index) => (
        <article class="certificate-card panel" data-reveal style={`--reveal-delay: ${(index % 2) * 100}ms`}>
          <a href={certificate.file} target="_blank" rel="noopener noreferrer" class="certificate-image-link" aria-label={`Open certificate: ${certificate.title}`}>
            <img
              src={certificate.image}
              alt={certificate.alt}
              width="1600"
              height="1160"
              loading="lazy"
              decoding="async"
              class="certificate-image"
            />
            <span class="certificate-type">Participation</span>
            <span class="view-label">View certificate <span aria-hidden="true">↗</span></span>
          </a>
          <div class="certificate-content">
            <p class="certificate-date">{certificate.date}</p>
            <h3>{certificate.title}</h3>
            <p class="certificate-issuer">{certificate.issuer}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="certificate-footnote">This section lists certificates currently available for review. Additional achievements can be added as they are located or earned.</p>
  </div>
</section>

<style>
  .certificate-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .certificate-heading .section-title { margin-bottom: 1.6rem; }
  .certificate-count {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .5rem;
    margin-bottom: .35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: .55rem .8rem;
    color: var(--muted);
    font-size: .58rem;
    font-weight: 750;
    letter-spacing: .13em;
  }
  .certificate-count strong { color: #d6c2ff; font-size: .82rem; letter-spacing: 0; }

  .certificate-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .certificate-card {
    overflow: hidden;
    transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
  }

  .certificate-card:hover {
    transform: translateY(-4px);
    border-color: #a476ff66;
    box-shadow: 0 18px 46px #0000002b;
  }

  .certificate-image-link {
    position: relative;
    display: grid;
    min-height: 14rem;
    aspect-ratio: 16 / 9;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse at 50% 45%, #2a2533, #17151b 70%);
  }

  .certificate-image {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 17rem;
    padding: .9rem;
    object-fit: contain;
    transition: transform .35s ease, filter .35s ease;
  }

  .certificate-image-link:hover .certificate-image { transform: scale(1.035); filter: brightness(1.08); }

  .certificate-type {
    position: absolute;
    top: .85rem;
    left: .85rem;
    border: 1px solid #ffffff26;
    border-radius: 999px;
    background: #121015c9;
    padding: .38rem .62rem;
    color: #e7def6;
    font-size: .6rem;
    font-weight: 650;
    backdrop-filter: blur(10px);
  }

  .view-label {
    position: absolute;
    right: .85rem;
    bottom: .85rem;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid #ffffff2a;
    border-radius: 999px;
    background: #111111d9;
    padding: .48rem .72rem;
    color: white;
    font-size: .68rem;
    font-weight: 600;
    backdrop-filter: blur(10px);
    transition: background .2s ease, transform .2s ease;
  }

  .certificate-image-link:hover .view-label { background: #533a7c; transform: translateY(-2px); }

  .certificate-content { padding: 1.2rem 1.3rem 1.35rem; }
  .certificate-date {
    margin: 0;
    color: var(--sec);
    font-size: .66rem;
    font-weight: 750;
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .certificate-content h3 {
    margin: .55rem 0 0;
    color: var(--white);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: -.02em;
  }
  .certificate-issuer { margin: .65rem 0 0; color: var(--muted); font-size: .76rem; line-height: 1.65; }
  .certificate-footnote { margin: 1.5rem 0 0; color: var(--muted); font-size: .72rem; line-height: 1.7; }

  @media (max-width: 640px) {
    .certificate-heading { align-items: flex-start; flex-direction: column; gap: .5rem; }
    .certificate-count { margin: 0; }
    .certificate-grid { grid-template-columns: 1fr; gap: 1rem; }
    .certificate-image-link { min-height: 12rem; }
    .certificate-content { padding: 1.05rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .certificate-card, .certificate-image, .view-label { transition: none; }
    .certificate-card:hover, .certificate-image-link:hover .certificate-image, .certificate-image-link:hover .view-label { transform: none; }
  }
</style>
