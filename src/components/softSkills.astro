---
const skills = [
  { mark: "PS", name: "Problem Solving" },
  { mark: "TW", name: "Teamwork" },
  { mark: "GC", name: "Good Communication" },
  { mark: "AD", name: "Adaptability" },
  { mark: "AT", name: "Attention to Detail" },
  { mark: "WL", name: "Willingness to Learn" },
];
---

<section id="soft-skills" class="section-block">
  <div class="page-width">
    <p class="section-kicker">05 / How I Work</p>
    <h2 class="section-title">Soft Skills</h2>
    <p class="section-copy -mt-3 mb-8 max-w-2xl">Personal and collaborative skills I value when learning, working with others, and approaching tasks.</p>
    <div class="soft-skill-grid">
      {skills.map((skill, index) => (
        <article class="soft-skill-card panel" data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
          <span class="soft-skill-mark" aria-hidden="true">{skill.mark}</span>
          <h3>{skill.name}</h3>
          <span class="soft-skill-index">0{index + 1}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .soft-skill-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .85rem;
  }

  .soft-skill-card {
    position: relative;
    display: flex;
    min-height: 7.4rem;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    padding: 1.15rem;
    transition: transform .25s ease, border-color .25s ease, background .25s ease, box-shadow .25s ease;
  }

  .soft-skill-card::after {
    position: absolute;
    top: -80%;
    left: -35%;
    width: 35%;
    height: 260%;
    background: linear-gradient(90deg, transparent, #a476ff0d, transparent);
    content: "";
    transform: rotate(24deg) translateX(-150%);
    transition: transform .65s ease;
    pointer-events: none;
  }

  .soft-skill-card:hover {
    transform: translateY(-4px);
    border-color: #a476ff66;
    background: linear-gradient(145deg, #211b2b, #151419 78%);
    box-shadow: 0 16px 36px #00000026;
  }

  .soft-skill-card:hover::after { transform: rotate(24deg) translateX(520%); }

  .soft-skill-mark {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid #a476ff55;
    border-radius: .9rem;
    background: #a476ff14;
    color: #d7c5ff;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: -.03em;
    box-shadow: inset 0 0 16px #a476ff0b;
    transition: transform .25s ease, background .25s ease;
  }

  .soft-skill-card:hover .soft-skill-mark { transform: rotate(-5deg) scale(1.06); background: #a476ff22; }
  .soft-skill-card h3 { margin: 0; color: var(--white); font-size: .9rem; font-weight: 620; line-height: 1.45; }
  .soft-skill-index { position: absolute; top: .7rem; right: .85rem; color: #706a79; font-size: .58rem; font-weight: 700; letter-spacing: .1em; }

  @media (max-width: 850px) {
    .soft-skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .soft-skill-grid { grid-template-columns: 1fr; gap: .65rem; }
    .soft-skill-card { min-height: 5.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .soft-skill-card, .soft-skill-card::after, .soft-skill-mark { transition: none; }
    .soft-skill-card:hover, .soft-skill-card:hover .soft-skill-mark { transform: none; }
  }
</style>
