---
const education = [
  {
    period: "2024 – Present",
    level: "College",
    program: "Bachelor of Science in Information Technology",
    school: "Filamer Christian University",
  },
  {
    period: "2022 – 2024",
    level: "Senior High School",
    program: "STEM",
    school: "Filamer Christian University",
  },
];
---

<section id="education" class="section-block">
  <div class="page-width">
    <p class="section-kicker">03 / Academic Background</p>
    <h2 class="section-title">Education</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {education.map((item) => (
        <article class="panel p-6 md:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="rounded-full border border-[#a476ff55] bg-[#a476ff15] px-3 py-1 text-xs font-semibold text-[#cdb4ff]">{item.level}</span>
            <span class="text-sm text-[var(--muted)]">{item.period}</span>
          </div>
          <h3 class="mt-6 text-xl md:text-2xl font-semibold leading-snug">{item.program}</h3>
          <p class="mt-3 text-[var(--white-icon)]">{item.school}</p>
          <p class="mt-1 text-sm text-[var(--muted)]">Roxas City, Capiz, Philippines</p>
        </article>
      ))}
    </div>
  </div>
</section>
