---
const baseUrl = import.meta.env.BASE_URL;
const inventoryRepository = "https://github.com/Mikthz/New-ITE-2-Project";
const inventoryDashboard = `${baseUrl}images/inventory-dashboard.webp`;
const inventoryProducts = `${baseUrl}images/inventory-products.webp`;
const inventoryAddProduct = `${baseUrl}images/inventory-add-product.webp`;
const inventoryVideo = `${baseUrl}videos/inventory-system-demo.mp4`;
const gameplayVideo = `${baseUrl}videos/angry-birds-face-ar-demo.mp4`;
---

<section id="projects" class="section-block">
  <div class="page-width">
    <p class="section-kicker">06 / Selected Work</p>
    <h2 class="section-title">My Projects</h2>
    <p class="section-copy -mt-3 mb-8 max-w-2xl">
      Collaborative projects developed with the same three-member team in 2026, combining web application development and interactive gameplay.
    </p>

    <div class="grid items-stretch gap-5 lg:grid-cols-2">
      <article class="project-card panel overflow-hidden">
        <a class="project-media project-main-preview" href={inventoryDashboard} target="_blank" rel="noopener noreferrer" aria-label="Open the inventory system dashboard screenshot">
          <img
            class="inventory-dashboard-image"
            src={inventoryDashboard}
            alt="Dashboard of the Computer Parts Inventory Management System showing inventory summaries and activity records"
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
          />
          <span class="media-badge">Application dashboard</span>
        </a>

        <div class="project-body">
          <div class="project-meta">
            <span>2026</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span>Collaborative project</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span>Team of 3</span>
          </div>

          <h3 class="project-title">Computer Parts Inventory Management System</h3>
          <p class="project-description">
            A web-based system developed to manage computer parts inventory and related records. Its interface includes an inventory dashboard, product records, product entry, and stock-status monitoring.
          </p>

          <div class="project-gallery">
            <p class="project-subheading">More interface previews</p>
            <div class="grid grid-cols-2 gap-3">
              <a class="screenshot-link" href={inventoryProducts} target="_blank" rel="noopener noreferrer">
                <img src={inventoryProducts} alt="Product inventory table showing product records, categories, suppliers, availability, and prices" width="1920" height="1080" loading="lazy" decoding="async" />
                <span>Product inventory</span>
              </a>
              <a class="screenshot-link" href={inventoryAddProduct} target="_blank" rel="noopener noreferrer">
                <img src={inventoryAddProduct} alt="Product information form for adding an item to the inventory system" width="1920" height="1080" loading="lazy" decoding="async" />
                <span>Add product</span>
              </a>
            </div>
          </div>

          <div class="project-focus">
            <p class="project-subheading">Project focus</p>
            <div class="focus-list">
              <span>Product records</span>
              <span>Inventory management</span>
              <span>Stock monitoring</span>
            </div>
          </div>

          <div class="project-stack">
            <p class="project-subheading">Technologies used</p>
            <div class="flex flex-wrap gap-2">
              {['Python', 'Django', 'Tailwind CSS', 'JavaScript', 'MariaDB'].map((tech) => <span class="skill-tag">{tech}</span>)}
            </div>
          </div>

          <details class="project-demo-details">
            <summary>
              <span>Watch project walkthrough</span>
              <span class="demo-duration">33 seconds <span aria-hidden="true">＋</span></span>
            </summary>
            <div class="project-demo-video-wrap">
              <video controls playsinline preload="none" poster={inventoryDashboard} aria-label="Screen recording walkthrough of the inventory management system">
                <source src={inventoryVideo} type="video/mp4" />
                Your browser does not support HTML video.
              </video>
            </div>
          </details>

          <div class="project-actions">
            <a class="project-link" href={inventoryRepository} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
              </svg>
              View archived repository
              <span aria-hidden="true">↗</span>
            </a>
            <span class="archive-note">Archived November 24, 2026</span>
          </div>
        </div>
      </article>

      <article class="project-card panel overflow-hidden">
        <div class="project-media game-media">
          <video
            class="project-video"
            controls
            playsinline
            preload="metadata"
            poster={`${baseUrl}images/angry-birds-face-ar-poster.jpg`}
            aria-label="Gameplay demonstration of Angry Birds Face AR"
          >
            <source src={gameplayVideo} type="video/mp4" />
            Your browser does not support HTML video. Please use a modern browser to view the gameplay demonstration.
          </video>
        </div>

        <div class="project-body">
          <div class="project-meta">
            <span>2026</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span>Collaborative project</span>
            <span class="meta-separator" aria-hidden="true">·</span>
            <span>Team of 3</span>
          </div>

          <h3 class="project-title">Angry Birds Face AR</h3>
          <p class="project-description">
            An interactive game inspired by Angry Birds that uses face and hand tracking as an alternative way to interact with slingshot-style gameplay. It combines projectile movement, physics, and collision detection.
          </p>

          <div class="project-focus">
            <p class="project-subheading">Gameplay elements</p>
            <div class="focus-list">
              <span>Face &amp; hand tracking</span>
              <span>Slingshot interaction</span>
              <span>Physics &amp; collisions</span>
            </div>
          </div>

          <div class="project-stack">
            <p class="project-subheading">Technologies used</p>
            <div class="flex flex-wrap gap-2">
              {['Python', 'OpenCV', 'MediaPipe'].map((tech) => <span class="skill-tag">{tech}</span>)}
            </div>
          </div>

          <div class="project-actions game-actions">
            <span class="demo-label"><span class="demo-dot" aria-hidden="true"></span> Gameplay demonstration</span>
            <span class="archive-note">23 second recording</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    height: 100%;
    transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }

  .project-card:hover {
    border-color: #a476ff55;
    box-shadow: 0 18px 55px #0000002b;
    transform: translateY(-3px);
  }

  .project-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project-main-preview {
    display: block;
    background: #172335;
  }

  .inventory-dashboard-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .35s ease;
  }

  .project-main-preview:hover .inventory-dashboard-image { transform: scale(1.025); }

  .media-badge {
    position: absolute;
    left: .85rem;
    bottom: .85rem;
    border: 1px solid #ffffff2c;
    border-radius: 999px;
    background: #101820d9;
    padding: .42rem .7rem;
    color: #f2f5fa;
    font-size: .65rem;
    font-weight: 600;
    backdrop-filter: blur(10px);
  }

  .game-media { background: #080808; }

  .project-video {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    background: #080808;
    object-fit: cover;
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.45rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .42rem;
    color: var(--muted);
    font-size: .7rem;
  }

  .meta-separator { color: #766b87; }

  .project-title {
    margin: .8rem 0 0;
    color: var(--white);
    font-size: clamp(1.25rem, 2.3vw, 1.55rem);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -.035em;
  }

  .project-description {
    margin: .75rem 0 0;
    color: var(--white-icon);
    font-size: .88rem;
    line-height: 1.75;
  }

  .project-gallery { margin-top: 1.2rem; }

  .screenshot-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid #ffffff20;
    border-radius: .8rem;
    background: #172335;
  }

  .screenshot-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease, opacity .3s ease;
  }

  .screenshot-link:hover img { transform: scale(1.045); opacity: .8; }

  .screenshot-link span {
    position: absolute;
    left: .5rem;
    bottom: .5rem;
    border: 1px solid #ffffff24;
    border-radius: 999px;
    background: #111c29df;
    padding: .32rem .55rem;
    color: #f2f5fa;
    font-size: .6rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }

  .project-focus,
  .project-stack { margin-top: 1.2rem; }

  .project-subheading {
    margin: 0 0 .6rem;
    color: #d0c2e5;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .focus-list { display: flex; flex-wrap: wrap; gap: .5rem; }

  .focus-list span {
    border: 1px solid #ffffff17;
    border-radius: .65rem;
    background: #ffffff06;
    padding: .47rem .65rem;
    color: #c3becb;
    font-size: .72rem;
    line-height: 1.3;
  }

  .project-stack .skill-tag { font-size: .76rem; }

  .project-demo-details {
    margin-top: 1.2rem;
    border: 1px solid #ffffff1b;
    border-radius: .85rem;
    background: #ffffff05;
    overflow: hidden;
  }

  .project-demo-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .8rem .95rem;
    color: #e5d8ff;
    font-size: .76rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .project-demo-details summary::-webkit-details-marker { display: none; }
  .project-demo-details summary::after { content: "＋"; color: #c7a9ff; font-size: 1rem; }
  .project-demo-details[open] summary::after { content: "−"; }
  .demo-duration { margin-left: auto; color: var(--muted); font-size: .68rem; font-weight: 500; }
  .demo-duration span { display: none; }

  .project-demo-video-wrap { padding: 0 .55rem .55rem; }
  .project-demo-video-wrap video { display: block; width: 100%; border-radius: .55rem; background: #080808; }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .85rem;
    margin-top: auto;
    padding-top: 1.35rem;
  }

  .project-link {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    gap: .55rem;
    border: 1px solid #a476ff66;
    border-radius: 999px;
    background: #a476ff14;
    padding: .65rem .9rem;
    color: #e5d8ff;
    font-size: .78rem;
    font-weight: 650;
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }

  .project-link:hover {
    border-color: #c7a9ff;
    background: #a476ff25;
    transform: translateY(-1px);
  }

  .project-link svg { width: 1rem; height: 1rem; }

  .archive-note { color: var(--muted); font-size: .68rem; line-height: 1.4; }

  .demo-label {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: #d6c5f3;
    font-size: .76rem;
    font-weight: 600;
  }

  .demo-dot {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    background: #a476ff;
    box-shadow: 0 0 0 4px #a476ff1b;
  }

  @media (max-width: 420px) {
    .project-body { padding: 1.15rem; }
    .project-actions { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card, .project-link, .inventory-dashboard-image, .screenshot-link img { transition: none; }
    .project-card:hover, .project-link:hover, .project-main-preview:hover .inventory-dashboard-image, .screenshot-link:hover img { transform: none; }
  }
</style>
